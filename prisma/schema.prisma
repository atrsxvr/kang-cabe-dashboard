datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  ADMIN
  AGRONOMIST
  LOGISTICS
  SALES
}

enum SeasonStatus {
  PLANNING
  ACTIVE
  HARVESTING
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Alur temuan lapangan: dilaporkan siapa saja, didiagnosa Agronomis, lalu
/// ditangani tim. Boolean tidak cukup — tahap "sudah didiagnosa, belum
/// disemprot" justru saat pekerjaan berpindah tangan.
enum FindingStatus {
  REPORTED
  DIAGNOSED
  TREATED
  RESOLVED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

/// Fase yang dipakai di lapangan. PRODUCTION terbuka ujungnya — cabai rawit
/// terus berproduksi berbulan-bulan, kebun rujukan sudah lewat HST 200.
enum GrowthPhase {
  VEGETATIVE
  GENERATIVE
  PRODUCTION
}

enum RecipeKind {
  ROUTINE // kebutuhan rutin per fase
  TREATMENT // penanganan masalah tertentu
}

enum ApplicationMethod {
  KOCOR
  SEMPROT
}

enum MaterialCategory {
  FERTILIZER
  PESTICIDE
  FUNGICIDE
  GROWTH_REGULATOR
  SEED
  MULCH
  SUPPLIES // polybag, tali, dan sejenisnya
  OTHER
}

/// Alasan stok berubah. Tanpa ini angka stok tidak bisa direkonsiliasi saat
/// terasa janggal, dan pembelian tidak bisa disambungkan ke modul Keuangan.
enum StockReason {
  PURCHASE
  USAGE
  CORRECTION
  LOSS
}

enum ToolCondition {
  GOOD
  NEEDS_SERVICE
  BROKEN
}

/// Kejadian pada alat. Yang mengurangi jumlah dipisahkan dari yang hanya
/// mengubah kondisi: alat hilang barangnya tidak ada lagi, alat rusak masih
/// ada dan mungkin bisa diperbaiki.
enum ToolEventType {
  ACQUIRED // beli/dapat baru, jumlah bertambah
  LOST // hilang, jumlah berkurang
  RETIRED // dipensiunkan, jumlah berkurang
  DAMAGED // rusak atau butuh servis, jumlah tetap
  SERVICED // selesai diservis, kondisi kembali baik
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Grade {
  GRADE_A
  GRADE_B
  GRADE_C
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(ADMIN)
  deletedAt DateTime? // Pekerja nonaktif ditandai di sini, barisnya tidak dihapus
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tasksAssigned     TaskAssignee[]
  findingsReported  HealthLog[]     @relation("ReportedFindings")
  findingsDiagnosed HealthLog[]     @relation("DiagnosedFindings")
  recipesAuthored   Recipe[]        @relation("AuthoredRecipes")
  stockMovements    StockMovement[] @relation("StockMovements")
  toolEvents        ToolEvent[]     @relation("ToolEvents")
  shoppingNotes     ShoppingNote[]  @relation("ShoppingNotes")

  @@index([deletedAt])
}

model Season {
  id         String       @id @default(uuid())
  name       String // Contoh: "Musim Tanam 1 - Rawit Ori 212"
  variety    String // Varietas benih
  plantCount Int // Jumlah populasi tanaman
  startDate  DateTime // Tanggal tanam (HST 0)
  endDate    DateTime? // Tanggal selesai musim
  status     SeasonStatus @default(PLANNING)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tasks               Task[]
  healthLogs          HealthLog[]
  harvestLogs         HarvestLog[]
  financeTransactions FinanceTransaction[]
}

model Task {
  id          String     @id @default(uuid())
  seasonId    String
  title       String
  description String?
  hst         Int? // Hari Setelah Tanam saat tugas direncanakan
  dueDate     DateTime
  status      TaskStatus @default(TODO)
  // Diisi saat status menjadi DONE, dikosongkan kalau dibatalkan. Terpisah dari
  // updatedAt supaya urutan Logbook tidak berubah saat tugas disunting.
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  /// Racikan asal, kalau tugas ini dibuat dari Pustaka Racikan. Hanya untuk
  /// label; takarannya disalin ke TaskMaterial, tidak dibaca ulang dari sini.
  recipeId        String?
  /// Volume yang benar-benar diracik, bisa berbeda dari volume acuan racikan.
  recipeVolumeL   Float?
  /// Diisi saat pemakaian bahannya sudah dipotong dari stok. Membuat
  /// pencatatan idempoten: tugas selesai yang belum tercatat masih bisa
  /// ditagih lewat tombol, dan yang sudah tidak bisa dipotong dua kali.
  usageRecordedAt DateTime?

  season    Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  assignees TaskAssignee[]
  // SetNull: menghapus racikan tidak boleh merusak tugas yang terlanjur
  // memakainya — salinan takarannya tetap utuh.
  recipe    Recipe?        @relation("RecipeTasks", fields: [recipeId], references: [id], onDelete: SetNull)
  materials TaskMaterial[]

  @@index([seasonId])
  @@index([status, dueDate]) // Papan tugas: filter status, urut jatuh tempo
  @@index([seasonId, completedAt]) // Logbook: riwayat selesai per musim
  @@index([recipeId])
}

/// Takaran yang disalin ke tugas saat dibuat dari racikan.
///
/// Menghitung ulang dari racikan saat tugas diselesaikan akan memotong stok
/// dengan angka berbeda dari yang tertulis di tugas, kalau dosisnya sempat
/// direvisi di antara kedua momen itu.
model TaskMaterial {
  id         String @id @default(uuid())
  taskId     String
  materialId String
  /// Jumlah pada satuan bahannya, sudah dikalikan volume.
  amount     Float
  /// Nilai rupiah pemakaian ini, dibekukan saat stok dipotong — sama seperti
  /// takarannya. Harga pupuk naik bulan depan tidak boleh menulis ulang biaya
  /// musim lalu. Kosong berarti pemakaiannya belum dicatat.
  totalCost  Int?

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([taskId, materialId])
  @@index([materialId])
}

// Penghubung Task <-> User. Satu tugas bisa dikerjakan beberapa orang.
model TaskAssignee {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Restrict: User dinonaktifkan lewat deletedAt, bukan dihapus. Ini jaring
  // pengaman kalau ada penghapusan permanen yang tidak disengaja.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([taskId, userId])
  @@index([userId]) // "tugas saya"; taskId sudah tercakup prefix primary key
}

model HealthLog {
  id          String        @id @default(uuid())
  seasonId    String
  hst         Int // Hari Setelah Tanam saat ditemukannya gejala
  photoUrl    String?
  location    String? // Petak/blok tempat temuan, kalau relevan
  symptoms    String // Gejala penyakit/hama
  severity    Severity      @default(MEDIUM)
  status      FindingStatus @default(REPORTED)
  diagnosis   String? // Diagnosa dari Agronomis
  treatment   String? // Solusi / Racikan obat
  diagnosedAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  reportedById  String?
  diagnosedById String?

  season      Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  // Restrict, konsisten dengan TaskAssignee: anggota dinonaktifkan lewat
  // deletedAt, bukan dihapus, supaya riwayat temuan tetap bisa ditelusuri.
  reportedBy  User?  @relation("ReportedFindings", fields: [reportedById], references: [id], onDelete: Restrict)
  diagnosedBy User?  @relation("DiagnosedFindings", fields: [diagnosedById], references: [id], onDelete: Restrict)

  @@index([seasonId])
  @@index([seasonId, status]) // Antrean temuan per tahap
  @@index([reportedById])
  @@index([diagnosedById])
}

/// Satu baris per bahan, dipakai bersama oleh Pustaka Racikan dan Inventaris.
/// Dipisah dulu akan berarti "NPK 16-16-16" diketik dua kali dan pertanyaan
/// "stok cukup untuk racikan ini?" tidak pernah bisa dijawab.
///
/// Tidak terikat musim: karung pupuk dipakai lintas musim tanam.
model Material {
  id       String           @id @default(uuid())
  name     String           @unique
  /// Satuan baku untuk bahan ini — takaran racikan dan stok memakai satuan
  /// yang sama, supaya keduanya bisa dibandingkan tanpa konversi.
  unit     String
  category MaterialCategory @default(FERTILIZER)

  stock    Float @default(0)
  /// Ambang peringatan. Status stok dihitung dari stock vs minStock, tidak
  /// disimpan — kolom status hanya bisa melenceng dari angka yang diwakilinya.
  minStock Float @default(0)

  /// Harga rata-rata bergerak per satuan, rupiah. Bukan sumber kebenaran:
  /// selalu bisa dibangun ulang dari StockMovement, dan memang harus, karena
  /// harga sebuah pembelian boleh diisi belakangan. Disimpan hanya supaya
  /// nilai gudang tidak perlu memindai seluruh riwayat tiap halaman dibuka.
  ///
  /// Float, bukan Int: ini tarif per satuan, bukan jumlah uang. Rp 32,5 per
  /// gram itu wajar; yang dibulatkan ke rupiah utuh adalah hasil kalinya.
  avgCost Float @default(0)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeItems RecipeItem[]
  movements   StockMovement[]
  taskUsages  TaskMaterial[]

  @@index([category])
}

/// Riwayat perubahan stok. Menjawab "kenapa NPK tinggal segini".
model StockMovement {
  id         String      @id @default(uuid())
  materialId String
  /// Positif menambah, negatif mengurangi.
  delta      Float
  reason     StockReason
  /// Total rupiah yang dibayar, hanya untuk PURCHASE. Boleh kosong: belanja
  /// tanpa nota di tangan tetap harus bisa dicatat, dan harganya dilengkapi
  /// belakangan. Selama kosong, rata-rata harga bahan tidak digeser.
  ///
  /// Int: rupiah tidak punya sen, dan Float menghasilkan selisih receh yang
  /// tidak akan pernah bisa dijelaskan ke siapa pun.
  totalCost  Int?
  note       String?
  actorId    String?
  createdAt  DateTime    @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  actor    User?    @relation("StockMovements", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([materialId, createdAt])
  @@index([actorId])
}

/// Alat kerja. Tabel sendiri karena cangkul tidak punya stok, satuan, atau
/// ambang minimum — yang ia punya kondisi dan riwayat servis.
model Tool {
  id             String        @id @default(uuid())
  name           String
  /// Berapa yang benar-benar dimiliki. Berkurang saat hilang atau
  /// dipensiunkan; nol berarti perlu diganti.
  quantity       Int           @default(1)
  /// Kondisi baris ini secara keseluruhan. Kalau satu dari beberapa unit
  /// rusak sendiri, pisahkan jadi baris tersendiri — satu baris hanya bisa
  /// mewakili satu kondisi.
  condition      ToolCondition @default(GOOD)
  lastServicedAt DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  events ToolEvent[]

  @@index([condition])
}

/// Riwayat alat, cerminan StockMovement untuk bahan. Menjawab "cangkul kita
/// dulu tiga, sekarang kenapa dua".
model ToolEvent {
  id        String        @id @default(uuid())
  toolId    String
  type      ToolEventType
  /// Berapa unit yang terdampak. Hanya berarti untuk kejadian yang mengubah
  /// jumlah.
  quantity  Int           @default(1)
  /// Uang keluar untuk kejadian ini — harga beli atau ongkos servis. Alat
  /// tidak disusutkan: cangkul tidak habis terpakai seperti pupuk, dan
  /// penyusutan hanya menghasilkan angka yang tidak dimengerti siapa pun.
  totalCost Int?
  note      String?
  actorId   String?
  createdAt DateTime      @default(now())

  tool  Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  actor User? @relation("ToolEvents", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([toolId, createdAt])
  @@index([actorId])
}

/// Baris belanja yang diketik sendiri: barang yang belum terdaftar, jasa
/// servis, atau apa pun yang perlu diurus saat ke kota. Daftar belanja yang
/// hanya bisa dihitung dari stok tidak punya tempat untuk hal-hal ini.
model ShoppingNote {
  id          String    @id @default(uuid())
  text        String
  done        Boolean   @default(false)
  completedAt DateTime?
  actorId     String?
  createdAt   DateTime  @default(now())

  actor User? @relation("ShoppingNotes", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([done, createdAt])
  @@index([actorId])
}

/// Racikan — pengetahuan yang dipakai ulang lintas musim, jadi **tidak**
/// terikat seasonId. Lihat pengecualian yang dicatat di CLAUDE.md.
model Recipe {
  id     String            @id @default(uuid())
  name   String
  kind   RecipeKind        @default(ROUTINE)
  method ApplicationMethod @default(SEMPROT)

  /// Diisi untuk racikan rutin.
  phase        GrowthPhase?
  /// Diisi untuk racikan penanganan, mis. "Antraknosa".
  targetIssue  String?
  /// "Ulangi tiap N hari" — di fase produksi perlakuan berputar, bukan sekali
  /// jalan di HST tertentu.
  intervalDays Int?

  /// Volume acuan saat racikan ditampilkan. Takaran disimpan per liter supaya
  /// tangki ukuran lain tetap benar tanpa hitung ulang.
  basisVolumeL Float @default(45)

  /// Masa tunggu panen setelah aplikasi, hari. Penting untuk kebun yang panen
  /// terus-menerus: menyemprot memblokir panen selama sekian hari.
  preHarvestIntervalDays Int?

  notes     String?
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User?        @relation("AuthoredRecipes", fields: [authorId], references: [id], onDelete: Restrict)
  items  RecipeItem[]
  tasks  Task[]       @relation("RecipeTasks")

  @@index([kind, phase])
  @@index([authorId])
}

model RecipeItem {
  id         String @id @default(uuid())
  recipeId   String
  materialId String

  /// Satuannya mengikuti Material.unit.
  amountPerLiter Float
  note           String?

  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([recipeId, materialId])
  @@index([materialId])
}

model HarvestLog {
  id          String   @id @default(uuid())
  seasonId    String
  harvestDate DateTime
  weightKg    Float // Total bobot panen
  gradeA      Float    @default(0) // bobot (kg)
  gradeB      Float    @default(0)
  gradeC      Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  season Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  sales  SaleTransaction[]

  @@index([seasonId])
  @@index([seasonId, harvestDate]) // Grafik hasil panen per musim
}

model SaleTransaction {
  id           String   @id @default(uuid())
  harvestLogId String
  buyerName    String // Nama pembeli/pengepul/restoran
  pricePerKg   Float
  totalAmount  Float
  isPaid       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  harvestLog HarvestLog @relation(fields: [harvestLogId], references: [id], onDelete: Cascade)

  @@index([harvestLogId])
  @@index([isPaid]) // Tagihan yang belum lunas
}

model FinanceTransaction {
  id          String          @id @default(uuid())
  seasonId    String
  type        TransactionType
  category    String // Benih, Pupuk, Peralatan, Penjualan, Operasional
  amount      Float
  description String
  proofUrl    String? // Foto nota/bukti
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId])
  @@index([seasonId, type]) // Rekap pemasukan vs pengeluaran per musim
  @@index([date])
}
