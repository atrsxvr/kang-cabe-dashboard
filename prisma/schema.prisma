datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  ADMIN
  AGRONOMIST
  LOGISTICS
  SALES
}

enum SeasonStatus {
  PLANNING
  ACTIVE
  HARVESTING
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Alur temuan lapangan: dilaporkan siapa saja, didiagnosa Agronomis, lalu
/// ditangani tim. Boolean tidak cukup — tahap "sudah didiagnosa, belum
/// disemprot" justru saat pekerjaan berpindah tangan.
enum FindingStatus {
  REPORTED
  DIAGNOSED
  TREATED
  RESOLVED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum InventoryStatus {
  SAFE
  LOW
  OUT_OF_STOCK
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Grade {
  GRADE_A
  GRADE_B
  GRADE_C
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(ADMIN)
  deletedAt DateTime? // Pekerja nonaktif ditandai di sini, barisnya tidak dihapus
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tasksAssigned      TaskAssignee[]
  findingsReported   HealthLog[]   @relation("ReportedFindings")
  findingsDiagnosed  HealthLog[]   @relation("DiagnosedFindings")

  @@index([deletedAt])
}

model Season {
  id          String       @id @default(uuid())
  name        String       // Contoh: "Musim Tanam 1 - Rawit Ori 212"
  variety     String       // Varietas benih
  plantCount  Int          // Jumlah populasi tanaman
  startDate   DateTime     // Tanggal tanam (HST 0)
  endDate     DateTime?    // Tanggal selesai musim
  status      SeasonStatus @default(PLANNING)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tasks                Task[]
  healthLogs           HealthLog[]
  harvestLogs          HarvestLog[]
  financeTransactions  FinanceTransaction[]
}

model Task {
  id          String     @id @default(uuid())
  seasonId    String
  title       String
  description String?
  hst         Int?       // Hari Setelah Tanam saat tugas direncanakan
  dueDate     DateTime
  status      TaskStatus @default(TODO)
  // Diisi saat status menjadi DONE, dikosongkan kalau dibatalkan. Terpisah dari
  // updatedAt supaya urutan Logbook tidak berubah saat tugas disunting.
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  season    Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  assignees TaskAssignee[]

  @@index([seasonId])
  @@index([status, dueDate]) // Papan tugas: filter status, urut jatuh tempo
  @@index([seasonId, completedAt]) // Logbook: riwayat selesai per musim
}

// Penghubung Task <-> User. Satu tugas bisa dikerjakan beberapa orang.
model TaskAssignee {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Restrict: User dinonaktifkan lewat deletedAt, bukan dihapus. Ini jaring
  // pengaman kalau ada penghapusan permanen yang tidak disengaja.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([taskId, userId])
  @@index([userId]) // "tugas saya"; taskId sudah tercakup prefix primary key
}

model HealthLog {
  id         String        @id @default(uuid())
  seasonId   String
  hst        Int           // Hari Setelah Tanam saat ditemukannya gejala
  photoUrl   String?
  location   String?       // Petak/blok tempat temuan, kalau relevan
  symptoms   String        // Gejala penyakit/hama
  severity   Severity      @default(MEDIUM)
  status     FindingStatus @default(REPORTED)
  diagnosis  String?       // Diagnosa dari Agronomis
  treatment  String?       // Solusi / Racikan obat
  diagnosedAt DateTime?
  resolvedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  reportedById  String?
  diagnosedById String?

  season       Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  // Restrict, konsisten dengan TaskAssignee: anggota dinonaktifkan lewat
  // deletedAt, bukan dihapus, supaya riwayat temuan tetap bisa ditelusuri.
  reportedBy   User?  @relation("ReportedFindings", fields: [reportedById], references: [id], onDelete: Restrict)
  diagnosedBy  User?  @relation("DiagnosedFindings", fields: [diagnosedById], references: [id], onDelete: Restrict)

  @@index([seasonId])
  @@index([seasonId, status]) // Antrean temuan per tahap
  @@index([reportedById])
  @@index([diagnosedById])
}

model Inventory {
  id          String          @id @default(uuid())
  name        String          // Nama pupuk/pestisida/alat
  category    String          // Pupuk, Pestisida, Alat, Mulsa, dll.
  stock       Float
  unit        String          // kg, liter, pcs, roll
  minStock    Float           // Batas minimum sebelum warning
  status      InventoryStatus @default(SAFE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model HarvestLog {
  id          String   @id @default(uuid())
  seasonId    String
  harvestDate DateTime
  weightKg    Float    // Total bobot panen
  gradeA      Float    @default(0) // bobot (kg)
  gradeB      Float    @default(0)
  gradeC      Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  sales  SaleTransaction[]

  @@index([seasonId])
  @@index([seasonId, harvestDate]) // Grafik hasil panen per musim
}

model SaleTransaction {
  id           String     @id @default(uuid())
  harvestLogId String
  buyerName    String     // Nama pembeli/pengepul/restoran
  pricePerKg   Float
  totalAmount  Float
  isPaid       Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  harvestLog HarvestLog @relation(fields: [harvestLogId], references: [id], onDelete: Cascade)

  @@index([harvestLogId])
  @@index([isPaid]) // Tagihan yang belum lunas
}

model FinanceTransaction {
  id          String          @id @default(uuid())
  seasonId    String
  type        TransactionType
  category    String          // Benih, Pupuk, Peralatan, Penjualan, Operasional
  amount      Float
  description String
  proofUrl    String?         // Foto nota/bukti
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId])
  @@index([seasonId, type]) // Rekap pemasukan vs pengeluaran per musim
  @@index([date])
}
