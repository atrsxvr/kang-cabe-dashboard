# Copy this file to `.env` and fill in your own connection string.
# `.env` is gitignored — never commit real credentials.

# PostgreSQL connection string.
# Neon:     postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/DBNAME?sslmode=require
# Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://user:password@host:5432/kang_cabe?sslmode=require"

# Session pooler (port 5432) for prisma migrate / studio, which need DDL.
DIRECT_URL="postgresql://user:password@host:5432/kang_cabe"

# Photo upload for plant findings. Optional — without it the app runs and
# findings can still be recorded, just without photos.
# Supabase dashboard → Project Settings → API keys → service_role.
# Keep it server-side only; it bypasses row-level security.
# SUPABASE_URL is derived from DATABASE_URL when omitted.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Login lewat Google. WAJIB, tidak seperti unggah foto di atas. ---
#
# Aplikasi yang jalan tanpa ini adalah aplikasi yang seluruh endpoint tulisnya
# terbuka, dan kegagalan itu tidak bersuara — jadi ia gagal saat boot.
#
# Google Cloud Console → APIs & Services → Credentials →
#   Create Credentials → OAuth client ID → Web application
# Authorized redirect URI, tambahkan yang dipakai:
#   http://localhost:3000/api/auth/callback/google
#   https://<domain-produksi>/api/auth/callback/google
# OAuth consent screen → External, lalu daftarkan Gmail anggota sebagai
# Test users. Dengan begitu tidak perlu verifikasi Google sama sekali.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Kunci penanda tangan cookie sesi: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Harus sama persis dengan yang didaftarkan di Google Cloud Console.
BETTER_AUTH_URL="http://localhost:3000"
